  .shine-stripe.back { animation:shineBackward 1.15s cubic-bezier(0.4,0,0.6,1) forwards; opacity:0; }
  @keyframes shineForward  { 0%{left:-200px;opacity:0} 8%{opacity:1} 100%{left:calc(100% + 30px);opacity:0.9} }
  @keyframes shineBackward { 0%{left:calc(100% + 30px);opacity:0} 8%{opacity:1} 100%{left:-200px;opacity:0.9} }
  .clean-gleam {
    position:absolute; inset:0; border-radius:var(--radius);
    background:linear-gradient(135deg,rgba(12,191,142,0.05) 0%,rgba(255,255,255,0.08) 50%,rgba(12,191,142,0.03) 100%);
    opacity:0; transition:opacity 0.8s ease; pointer-events:none; z-index:4;
  }
  .clean-gleam.visible { opacity:1; }
  .mop-overlay {
    position:absolute; inset:0; border-radius:var(--radius);
    background:rgba(224,250,242,0.48); backdrop-filter:blur(2px);
    z-index:6; opacity:0; pointer-events:none; transition:opacity 0.35s;
  }
  .mop-overlay.active { opacity:1; }
  .mop-overlay.done   { opacity:0; transition:opacity 0.7s ease 0.4s; }
  .form-wrap.mop-form-inner {
    position:relative; overflow:visible;
