// ── AUDIO CONTEXT ──
let audioCtx = null;
function getCtx() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}

// ── WET MOP SQUISH SOUND (soaked mop on floor) ──
function playWetMopSquish(intensity) {
  const ctx = getCtx();
  const now = ctx.currentTime;
  const vol = (intensity || 1) * 0.13;

  // Low-frequency "thud" of wet fabric hitting floor
  const osc = ctx.createOscillator();
  osc.type = 'sine';
  osc.frequency.setValueAtTime(95, now);
  osc.frequency.exponentialRampToValueAtTime(48, now + 0.22);
  const oscGain = ctx.createGain();
  oscGain.gain.setValueAtTime(0, now);
  oscGain.gain.linearRampToValueAtTime(vol * 0.55, now + 0.012);
  oscGain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);
  osc.connect(oscGain); oscGain.connect(ctx.destination);
  osc.start(now); osc.stop(now + 0.3);

  // Wet friction noise (the squelch/swish)
  const bufSize = Math.floor(ctx.sampleRate * 0.28);
  const buf = ctx.createBuffer(1, bufSize, ctx.sampleRate);
  const d = buf.getChannelData(0);
  for (let i = 0; i < bufSize; i++) {
    d[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufSize * 0.45));
  }
  const noise = ctx.createBufferSource();
  noise.buffer = buf;
  const lpf = ctx.createBiquadFilter();
  lpf.type = 'bandpass';
  lpf.frequency.setValueAtTime(420, now);
  lpf.frequency.exponentialRampToValueAtTime(160, now + 0.25);
  lpf.Q.value = 1.8;
  const noiseGain = ctx.createGain();
  noiseGain.gain.setValueAtTime(0, now);
  noiseGain.gain.linearRampToValueAtTime(vol, now + 0.018);
  noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.26);
  noise.connect(lpf); lpf.connect(noiseGain); noiseGain.connect(ctx.destination);
  noise.start(now);

  // Water slosh overtone
  const osc2 = ctx.createOscillator();
  osc2.type = 'triangle';
  osc2.frequency.setValueAtTime(180, now);
  osc2.frequency.exponentialRampToValueAtTime(90, now + 0.18);
  const g2 = ctx.createGain();
  g2.gain.setValueAtTime(0, now);
  g2.gain.linearRampToValueAtTime(vol * 0.3, now + 0.01);
  g2.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
  osc2.connect(g2); g2.connect(ctx.destination);
  osc2.start(now); osc2.stop(now + 0.22);
}


// ── SPARKLES ──
function spawnSparkles() {
  const sc = document.getElementById('sparkleContainer');
  const cx = window.innerWidth / 2;
  const cy = window.innerHeight * 0.4;
