  .shine-stripe {
    position:absolute; top:0; bottom:0; width:180px; opacity:0;
    background:linear-gradient(90deg,transparent 0%,rgba(12,191,142,0.09) 30%,rgba(255,255,255,0.22) 55%,rgba(12,191,142,0.09) 75%,transparent 100%);
    left:-200px;
  }
