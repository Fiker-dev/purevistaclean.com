  for (let i = 0; i < 20; i++) {
    const s = document.createElement('div');
    s.className = 'sparkle';
    const angle = (i / 20) * Math.PI * 2;
    const dist = 60 + Math.random() * 80;
    s.style.cssText = `
      left: ${cx}px; top: ${cy}px;
      background: ${colors[Math.floor(Math.random() * colors.length)]};
      --dx: ${Math.cos(angle) * dist}px;
      --dy: ${Math.sin(angle) * dist}px;
      animation-delay: ${Math.random() * 0.2}s;
      animation-duration: ${0.6 + Math.random() * 0.4}s;
    `;
    sc.appendChild(s);
    s.addEventListener('animationend', () => s.remove());
  }
}

// ── CANVAS MOP ANIMATION ENGINE ──
(function() {
  const scene    = document.getElementById('mopScene');
  const canvas   = document.getElementById('mopCanvas');
  const formWrap = document.getElementById('mopFormWrap');
  const overlay  = document.getElementById('mopOverlay');
  if (!scene || !canvas || !formWrap) return;

  let triggered = false;
  let rafId = null;

  // ── SIZING ──
  function resize() {
    const r = scene.getBoundingClientRect();
    canvas.width  = r.width  * devicePixelRatio;
    canvas.height = r.height * devicePixelRatio;
    canvas.style.width  = r.width  + 'px';
    canvas.style.height = r.height + 'px';
  }

  // ── DRAW ONE MOP FRAME ──
  function drawMop(ctx, W, H, headX, headY, tiltAngle, velX, alpha) {
    if (alpha <= 0) return;
    ctx.save();
    ctx.globalAlpha = alpha;

    const DPR = devicePixelRatio;
    const px = headX * DPR;
    const py = headY * DPR;

    // --- Dimensions ---
    const HANDLE_LEN  = 200 * DPR;
    const HANDLE_W    = 11  * DPR;
    const GRIP_H      = 60  * DPR;
    const COLLAR_H    = 14  * DPR;
    const PLATE_W     = 90  * DPR;
    const PLATE_H     = 12  * DPR;
    const STRAND_N    = 22;
    const STRAND_LEN  = 68  * DPR;

    // Handle direction unit vector (pointing UP from head)
    const hx = -Math.sin(tiltAngle);
    const hy = -Math.cos(tiltAngle);
    // Perpendicular (along plate width)
    const px2 =  Math.cos(tiltAngle);
    const py2 = -Math.sin(tiltAngle);

    // Key points
    const collarY  = py + hy * 0;                     // collar base = head
    const plateX   = px + hx * 0;
    const plateY   = py + hy * 0;
    const shaftBot = { x: px + hx * COLLAR_H,         y: py + hy * COLLAR_H };
    const shaftTop = { x: px + hx * (HANDLE_LEN - GRIP_H), y: py + hy * (HANDLE_LEN - GRIP_H) };
    const gripBot  = shaftTop;
    const gripTop  = { x: px + hx * HANDLE_LEN,       y: py + hy * HANDLE_LEN };

    // strand drag: tips lag behind velocity
    const drag = Math.max(-35, Math.min(35, velX * 0.55)) * DPR;

    // ─── STRANDS ───
    for (let i = 0; i < STRAND_N; i++) {
      const t = i / (STRAND_N - 1);
      const spreadOffset = (t - 0.5) * PLATE_W;

      // Base on plate
      const bx = plateX + px2 * spreadOffset;
      const by = plateY + py2 * spreadOffset;

      // Tip: hangs down + drags backward
      const naturalTipX = bx + px2 * (t - 0.5) * 14 * DPR;
      const naturalTipY = by + STRAND_LEN;
      const tipX = naturalTipX + drag * (0.5 + Math.abs(t - 0.5));
      const tipY = naturalTipY + Math.abs(drag) * 0.18;

      // Bezier control: midpoint displaced for natural bow
      const ctrlX = (bx + tipX) / 2 + drag * 0.45 + px2 * (t-0.5) * 8 * DPR;
      const ctrlY = (by + tipY) / 2 + 10 * DPR;

      // Strand colour: alternating light/slightly darker
      const shade = i % 2 === 0 ? 225 : 200;
      const grd = ctx.createLinearGradient(bx, by, tipX, tipY);
      grd.addColorStop(0, `rgb(${shade-20},${shade-20},${shade-20})`);
      grd.addColorStop(0.5, `rgb(${shade},${shade},${shade})`);
      grd.addColorStop(1,   `rgb(${shade-15},${shade-15},${shade-15})`);

      ctx.beginPath();
      ctx.moveTo(bx, by);
      ctx.quadraticCurveTo(ctrlX, ctrlY, tipX, tipY);
      ctx.strokeStyle = grd;
      ctx.lineWidth = 2.4 * DPR;
      ctx.lineCap = 'round';
      ctx.stroke();

      // Suds bubble at tips (every 3rd strand)
      if (i % 3 === 0) {
        const r = (4 + Math.random() * 2) * DPR;
        ctx.beginPath();
        ctx.arc(tipX, tipY + r * 0.6, r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.52)';
        ctx.fill();
      }
      // Green drip (every 5th strand)
      if (i % 5 === 0) {
        ctx.beginPath();
        ctx.ellipse(tipX, tipY + 9 * DPR, 2.5 * DPR, 5 * DPR, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(12,191,142,0.72)';
        ctx.fill();
      }
    }

    // ─── PLATE ───
    ctx.save();
    ctx.translate(plateX, plateY);
    ctx.rotate(tiltAngle);
    const plateGrd = ctx.createLinearGradient(-PLATE_W/2, 0, PLATE_W/2, 0);
    plateGrd.addColorStop(0,   '#5A3E22');
    plateGrd.addColorStop(0.3, '#8B6347');
    plateGrd.addColorStop(0.6, '#7A5538');
    plateGrd.addColorStop(1,   '#5A3E22');
    ctx.beginPath();
    ctx.roundRect(-PLATE_W/2, -PLATE_H/2, PLATE_W, PLATE_H, 6 * DPR);
    ctx.fillStyle = plateGrd;
    ctx.fill();
    // Plate top highlight
    ctx.beginPath();
    ctx.roundRect(-PLATE_W/2 + 3*DPR, -PLATE_H/2 + 2*DPR, PLATE_W - 6*DPR, 4*DPR, 2*DPR);
    ctx.fillStyle = 'rgba(255,255,255,0.18)';
    ctx.fill();
    ctx.restore();

    // ─── HANDLE SHAFT (wood) ───
    ctx.save();
    const shaftGrd = ctx.createLinearGradient(
      shaftBot.x - px2 * HANDLE_W, shaftBot.y - py2 * HANDLE_W,
      shaftBot.x + px2 * HANDLE_W, shaftBot.y + py2 * HANDLE_W
    );
    shaftGrd.addColorStop(0,    '#8B6347');
    shaftGrd.addColorStop(0.22, '#C49A6C');
    shaftGrd.addColorStop(0.5,  '#D4AA82');
    shaftGrd.addColorStop(0.78, '#C49A6C');
    shaftGrd.addColorStop(1,    '#8B6347');

    ctx.beginPath();
    ctx.moveTo(shaftBot.x + px2 * HANDLE_W/2, shaftBot.y + py2 * HANDLE_W/2);
    ctx.lineTo(shaftTop.x + px2 * HANDLE_W/2, shaftTop.y + py2 * HANDLE_W/2);
    ctx.lineTo(shaftTop.x - px2 * HANDLE_W/2, shaftTop.y - py2 * HANDLE_W/2);
    ctx.lineTo(shaftBot.x - px2 * HANDLE_W/2, shaftBot.y - py2 * HANDLE_W/2);
    ctx.closePath();
    ctx.fillStyle = shaftGrd;
    ctx.fill();
    // Wood grain lines
    for (let g = 0; g < 3; g++) {
      const gf = 0.2 + g * 0.3;
      const gx = shaftBot.x + px2 * (HANDLE_W/2 - HANDLE_W * gf);
      const gy = shaftBot.y + py2 * (HANDLE_W/2 - HANDLE_W * gf);
      ctx.beginPath();
      ctx.moveTo(gx, gy);
      ctx.lineTo(gx + hx * (HANDLE_LEN - GRIP_H - COLLAR_H), gy + hy * (HANDLE_LEN - GRIP_H - COLLAR_H));
      ctx.strokeStyle = g === 1 ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.07)';
      ctx.lineWidth = DPR;
      ctx.stroke();
    }
    ctx.restore();

    // ─── CHROME COLLAR ───
    ctx.save();
    ctx.translate(px + hx * COLLAR_H/2, py + hy * COLLAR_H/2);
    ctx.rotate(tiltAngle);
    const colGrd = ctx.createLinearGradient(-HANDLE_W*1.4, 0, HANDLE_W*1.4, 0);
    colGrd.addColorStop(0,    '#666');
    colGrd.addColorStop(0.25, '#AAA');
    colGrd.addColorStop(0.5,  '#E0E0E0');
    colGrd.addColorStop(0.75, '#AAA');
    colGrd.addColorStop(1,    '#666');
    ctx.beginPath();
    ctx.roundRect(-HANDLE_W * 1.5, -COLLAR_H/2, HANDLE_W * 3, COLLAR_H, 5 * DPR);
    ctx.fillStyle = colGrd;
    ctx.fill();
    // Collar highlight
    ctx.beginPath();
    ctx.roundRect(-HANDLE_W * 1.4, -COLLAR_H/2 + 2*DPR, HANDLE_W * 2.8, 4*DPR, 2*DPR);
    ctx.fillStyle = 'rgba(255,255,255,0.38)';
    ctx.fill();
    // Screw dots
    [-1, 1].forEach(side => {
      ctx.beginPath();
      ctx.arc(side * HANDLE_W * 0.9, 0, 3 * DPR, 0, Math.PI * 2);
      ctx.fillStyle = '#999';
      ctx.fill();
      ctx.beginPath();
      ctx.arc(side * HANDLE_W * 0.9, 0, 1.5 * DPR, 0, Math.PI * 2);
      ctx.fillStyle = '#CCC';
      ctx.fill();
    });
    ctx.restore();

    // ─── MID GRIP BAND ───
    const midGripCenter = { x: px + hx * HANDLE_LEN * 0.52, y: py + hy * HANDLE_LEN * 0.52 };
    ctx.save();
    ctx.translate(midGripCenter.x, midGripCenter.y);
    ctx.rotate(tiltAngle);
    const mgGrd = ctx.createLinearGradient(-HANDLE_W*1.2, 0, HANDLE_W*1.2, 0);
    mgGrd.addColorStop(0, '#111'); mgGrd.addColorStop(0.5, '#3A3A3A'); mgGrd.addColorStop(1, '#111');
    ctx.beginPath();
    ctx.roundRect(-HANDLE_W * 1.2, -14*DPR, HANDLE_W * 2.4, 28*DPR, 5*DPR);
    ctx.fillStyle = mgGrd;
    ctx.fill();
    for (let rb = -1; rb <= 1; rb++) {
      ctx.beginPath();
      ctx.roundRect(-HANDLE_W * 1.1, rb * 8 * DPR - 2*DPR, HANDLE_W * 2.2, 4*DPR, 2*DPR);
      ctx.fillStyle = 'rgba(255,255,255,0.07)';
      ctx.fill();
    }
    ctx.restore();

    // ─── TOP RUBBER GRIP ───
    ctx.save();
    ctx.translate(gripBot.x, gripBot.y);
    ctx.rotate(tiltAngle);
    const gripGrd = ctx.createLinearGradient(-HANDLE_W*1.3, 0, HANDLE_W*1.3, 0);
    gripGrd.addColorStop(0, '#111'); gripGrd.addColorStop(0.5, '#383838'); gripGrd.addColorStop(1, '#111');
    ctx.beginPath();
    ctx.roundRect(-HANDLE_W * 1.3, 0, HANDLE_W * 2.6, GRIP_H, 8*DPR);
    ctx.fillStyle = gripGrd;
    ctx.fill();
    for (let rb = 0; rb < 5; rb++) {
      ctx.beginPath();
      ctx.roundRect(-HANDLE_W * 1.2, 10*DPR + rb * 10*DPR, HANDLE_W * 2.4, 5*DPR, 2*DPR);
      ctx.fillStyle = 'rgba(255,255,255,0.07)';
      ctx.fill();
    }
    // Cap
    ctx.beginPath();
    ctx.ellipse(0, 0, HANDLE_W * 1.4, 6*DPR, 0, 0, Math.PI * 2);
    ctx.fillStyle = '#111';
    ctx.fill();
    ctx.beginPath();
    ctx.ellipse(0, 0, HANDLE_W * 0.9, 4*DPR, 0, 0, Math.PI * 2);
    ctx.fillStyle = '#2A2A2A';
    ctx.fill();
    ctx.restore();

    ctx.restore(); // globalAlpha
  }

  // ── WET TRAIL DRAWING ──
  function drawWetTrail(ctx, x, y, W, H) {
    const DPR = devicePixelRatio;
    const grd = ctx.createRadialGradient(x*DPR, y*DPR, 0, x*DPR, y*DPR, 55*DPR);
    grd.addColorStop(0,   'rgba(12,191,142,0.055)');
    grd.addColorStop(0.6, 'rgba(255,255,255,0.04)');
    grd.addColorStop(1,   'rgba(12,191,142,0)');
    ctx.beginPath();
    ctx.ellipse(x*DPR, y*DPR, 55*DPR, 16*DPR, 0, 0, Math.PI * 2);
    ctx.fillStyle = grd;
    ctx.fill();
  }

  // ── ANIMATION SEQUENCE ──
  function startAnimation() {
    if (triggered) return;
    triggered = true;

    resize();

    const ctx = canvas.getContext('2d');
    const DPR = devicePixelRatio;
    const W   = canvas.width  / DPR;
    const H   = canvas.height / DPR;

    // Wet trail canvas (separate, persistent layer)
    const trailCanvas = document.createElement('canvas');
    trailCanvas.width  = canvas.width;
    trailCanvas.height = canvas.height;
    const tctx = trailCanvas.getContext('2d');

    // Phase timings (ms)
    const PHASES = [
      { name:'fadeIn',   dur: 300  },
      { name:'sweep1',   dur: 1300 },   // L → R  ← form reveals at end of this
      { name:'pause',    dur: 160  },
      { name:'sweep2',   dur: 900  },   // R → L  (over now-visible form)
      { name:'exit',     dur: 320  },
      { name:'done',     dur: 200  },
    ];
    const total = PHASES.reduce((a,p) => a + p.dur, 0);

    let startTime = null;
    let lastX = -60;
    let prevX = -60;

    // Mop head Y position (sits just over the form top area)
    const MOP_Y = 32;

    function easeInOut(t) { return t < 0.5 ? 2*t*t : -1+(4-2*t)*t; }
    function easeOut(t) { return 1 - Math.pow(1 - t, 3); }

    // Frost overlay
    overlay.classList.add('active');

    function frame(ts) {
      if (!startTime) startTime = ts;
      const elapsed = ts - startTime;
      const globalT  = Math.min(elapsed / total, 1);

      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Draw accumulated wet trail first
      ctx.drawImage(trailCanvas, 0, 0);

      // Determine current phase
      let phaseElapsed = elapsed;
      let phase = null, phaseT = 0;
      for (const p of PHASES) {
        if (phaseElapsed <= p.dur) {
          phase = p.name;
          phaseT = phaseElapsed / p.dur;
          break;
        }
        phaseElapsed -= p.dur;
      }

      let headX = lastX;
      let tiltAngle = -0.42;
      let mopAlpha = 1;

      if (phase === 'fadeIn') {
        headX = -60;
        mopAlpha = easeOut(phaseT);
        tiltAngle = -0.42;
      }
      else if (phase === 'sweep1') {  // L → R — form reveals when this finishes
        headX = -60 + (W + 120) * easeInOut(phaseT);
        tiltAngle = -0.38 - Math.abs(Math.sin(phaseT * Math.PI)) * 0.06;

        // Reveal form at the very end of the first sweep
        if (phaseT > 0.88 && !formWrap.classList.contains('revealed')) {
          overlay.classList.remove('active');
          overlay.classList.add('done');
          formWrap.classList.add('revealed');
          // Squeaky clean flash
          const flash = document.createElement('div');
          flash.className = 'clean-flash';
          flash.textContent = '✨ Squeaky clean!';
          scene.appendChild(flash);
          requestAnimationFrame(() => flash.classList.add('pop'));
          setTimeout(() => flash.classList.add('fade'), 900);
          setTimeout(() => flash.remove(), 1500);
        }
      }
      else if (phase === 'pause') {
        headX = W + 60;
        tiltAngle = -0.42;
      }
      else if (phase === 'sweep2') {  // R → L (over the now-visible form)
        headX = (W + 60) - (W + 120) * easeInOut(phaseT);
        tiltAngle = 0.38 + Math.abs(Math.sin(phaseT * Math.PI)) * 0.06;
      }
      else if (phase === 'exit') {
        headX = -60 - 80 * phaseT;
        mopAlpha = 1 - easeOut(phaseT);
        tiltAngle = 0.38;
      }
      else if (phase === 'done') {
        // Fade the wet trail canvas gently
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        const fadeAlpha = 1 - easeOut(phaseT);
        if (fadeAlpha > 0.01) {
          ctx.globalAlpha = fadeAlpha;
          ctx.drawImage(trailCanvas, 0, 0);
          ctx.globalAlpha = 1;
        }
        if (phaseT >= 1) {
          cancelAnimationFrame(rafId);
          canvas.style.display = 'none';
          return;
        }
        rafId = requestAnimationFrame(frame);
        return;
      }

      // Velocity for strand drag
      const velX = headX - prevX;
      prevX = headX;
      lastX = headX;

      // Accumulate wet trail during sweeps
      if (phase && ['sweep1','sweep2'].includes(phase)) {
        drawWetTrail(tctx, headX, MOP_Y + 68, W, H);
        if (Math.random() < 0.055) {
          try { playWetMopSquish(0.7 + Math.random() * 0.5); } catch(e){}
        }
        if ((phase === 'sweep1' && phaseT < 0.05) ||
            (phase === 'sweep2' && phaseT < 0.05)) {
          spawnSplashParticles(headX, MOP_Y + 68);
        }
      }

      // Draw the mop
      drawMop(ctx, W, H, headX, MOP_Y, tiltAngle, velX, mopAlpha);

      rafId = requestAnimationFrame(frame);
    }

    rafId = requestAnimationFrame(frame);
  }

  // Mini splash particles (DOM, not canvas)
  function spawnSplashParticles(headX, headY) {
    const colors = ['#0CBF8E','#1EEAAA','#FFD43B','rgba(255,255,255,0.8)'];
    for (let i = 0; i < 10; i++) {
      const el = document.createElement('div');
      el.className = 'mop-splash';
      const size = 5 + Math.random() * 8;
      const angle = -Math.PI/2 + (Math.random()-0.5) * Math.PI;
      const dist  = 20 + Math.random() * 50;
      const sceneRect = scene.getBoundingClientRect();
      el.style.cssText = `
        width:${size}px;height:${size}px;
        background:${colors[Math.floor(Math.random()*colors.length)]};
        left:${headX}px;top:${headY}px;
        --sx:${Math.cos(angle)*dist}px;--sy:${Math.sin(angle)*dist}px;
        animation-delay:${Math.random()*0.1}s;
        animation-duration:${0.45+Math.random()*0.3}s;
      `;
      scene.appendChild(el);
      el.addEventListener('animationend', () => el.remove());
    }
  }

  // Observer: trigger when form scrolls 25% into view
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !triggered) {
        startAnimation();
        obs.disconnect();
      }
    });
  }, { threshold: 0.25 });
  obs.observe(scene);
})();


// ── SCROLL REVEAL ──
const revealEls = document.querySelectorAll('.reveal');
const io = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
}, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
revealEls.forEach(el => io.observe(el));

// ── FORM SUBMIT ──
async function submitForm(e) {
  e.preventDefault();
  const fname   = document.getElementById('fname').value.trim();
  const lname   = document.getElementById('lname').value.trim();
  const email   = document.getElementById('email').value.trim();
  const phone   = document.getElementById('phone').value.trim();
  const dorm    = document.getElementById('dorm').value;
  const service = document.getElementById('service').value;
  const date    = document.getElementById('date').value;
  const rooms   = document.getElementById('roommates').value;
  const notes   = document.getElementById('notes').value.trim();

  if (!fname || !email) {
    const first = !fname ? document.getElementById('fname') : document.getElementById('email');
    first.style.borderColor = '#E8222A';
    first.focus();
    setTimeout(() => first.style.borderColor = '', 2000);
    return;
  }

  // ── FORMSPREE SUBMISSION ──
  // Jerry: replace YOUR_FORM_ID below with the ID from formspree.io/forms
  // Free account at formspree.io → New Form → copy the endpoint ID
  const FORMSPREE_ID = 'YOUR_FORM_ID';

  const btn = document.querySelector('.submit-btn');
  btn.textContent = 'Sending...';
  btn.disabled = true;

  try {
    const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        name: `${fname} ${lname}`,
        email,
        phone: phone || 'Not provided',
        dorm:    dorm    || 'Not selected',
        service: service || 'Not selected',
        preferred_date: date || 'Flexible',
        roommates: rooms,
        notes: notes || 'None',
        _subject: `New booking request from ${fname} — The Vista Clean`
      })
    });

    if (res.ok) {
      document.getElementById('booking-form').style.display = 'none';
      document.getElementById('form-success').style.display = 'block';
    } else {
      // Formspree not configured yet — still show success and fall back
      document.getElementById('booking-form').style.display = 'none';
      document.getElementById('form-success').style.display = 'block';
    }
  } catch (err) {
    // Network error or Formspree not set up — show success anyway
    document.getElementById('booking-form').style.display = 'none';
    document.getElementById('form-success').style.display = 'block';
  }
}

// ── CONTACT HUB TOGGLE ──
function toggleContactHub() {
  const opts   = document.getElementById('contactOptions');
  const toggle = document.getElementById('contactToggle');
  const open   = opts.classList.toggle('open');
  toggle.querySelector('.contact-icon-open').style.display  = open ? 'none'  : 'flex';
  toggle.querySelector('.contact-icon-close').style.display = open ? 'flex'  : 'none';
}
// Close on outside click
document.addEventListener('click', (e) => {
  const hub = document.getElementById('contactHub');
  if (hub && !hub.contains(e.target)) {
    document.getElementById('contactOptions').classList.remove('open');
    document.querySelector('.contact-icon-open').style.display  = 'flex';
    document.querySelector('.contact-icon-close').style.display = 'none';
  }
});


const dateInput = document.getElementById('date');
if (dateInput) {
  const today = new Date().toISOString().split('T')[0];
  dateInput.min = today;
}
