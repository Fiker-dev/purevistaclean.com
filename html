  }
  @keyframes mopSweepAcross {
    0%   { left:-130px; transform:rotate(-38deg); }
    42%  { left:calc(100% + 60px); transform:rotate(-38deg); }
    50%  { left:calc(100% + 60px); transform:rotate(-142deg); }
